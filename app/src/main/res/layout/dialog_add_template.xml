<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:background="@drawable/dialog_background">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_add_test"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:textColor="@color/gray_dark"
        android:layout_marginBottom="16dp" />

    <!-- Nome do Paciente -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_patient_name"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/gray_dark"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/editText_test_name"
        style="@style/EditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_patient_name"
        android:inputType="text"
        android:layout_marginBottom="18dp" />

    <!-- Container com duas colunas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!-- Coluna Esquerda: Tipo de Teste -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:orientation="vertical"
            android:gravity="top"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_test_type"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="top">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hiv"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/test_hiv"
                    android:layout_marginBottom="6dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="999dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sifilis"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/test_sifilis"
                    android:layout_marginBottom="6dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="999dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hepatite_b"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/test_hepatite_b"
                    android:layout_marginBottom="6dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="999dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hepatite_c"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/test_hepatite_c"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="999dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coluna Direita: Tempo de Teste -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="top"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_test_duration"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/duration_container_hiv"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/time_button_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_duration_hiv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/label_test_duration"
                    android:textColor="@color/gray_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/duration_container_sifilis"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/time_button_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_duration_sifilis"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/label_test_duration"
                    android:textColor="@color/gray_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/duration_container_hepatite_b"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/time_button_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_duration_hepatite_b"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/label_test_duration"
                    android:textColor="@color/gray_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/duration_container_hepatite_c"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/time_button_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_duration_hepatite_c"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/label_test_duration"
                    android:textColor="@color/gray_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botões -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:baselineAligned="false"
        android:layout_marginTop="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:weightSum="2">

        <Button
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/button_cancel"
            android:textAllCaps="true"
            android:background="@drawable/secondary_action_button"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false" />

        <Button
            android:id="@+id/button_start_test"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/button_start_test"
            android:textAllCaps="true"
            android:background="@drawable/primary_action_button"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:singleLine="true"
            android:elevation="4dp"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
