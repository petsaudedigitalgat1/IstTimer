<resources>
    <!-- Tema da Aplicação -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Cores Primárias -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        
        <!-- Cores de Status -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        
        <!-- Estilos de Texto -->
        <item name="android:textColorPrimary">@color/colorPrimary</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>
    </style>
    
    <!-- Estilo para EditText -->
    <style name="EditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/gray_medium</item>
        <item name="android:background">@drawable/edit_text_background</item>
        <item name="android:padding">12dp</item>
    </style>
    
    <!-- Estilo para Botão Principal -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/colorAccent</item>
    </style>
    
    <!-- Estilo para Botão Secundário -->
    <style name="ButtonSecondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/gray_dark</item>
        <item name="backgroundTint">@color/buttonGray</item>
    </style>
</resources>
